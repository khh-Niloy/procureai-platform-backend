# Application
NODE_ENV=development
PORT=3000
PLATFORM_NAME=ProcureAi

# Database (Prisma Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/procureai?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=super-secret-key-12345
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key-12345
JWT_REFRESH_EXPIRES_IN=30d

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads
MAX_FILE_SIZE=10485760

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# AWS (If applicable)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_FILE_LOAD_BASE=
