model PurchaseRequest {
  id             String @id @default(uuid())
  organizationId String
  requesterId    String

  title       String
  description String
  budget      Decimal?
  currency    String    @default("BDT")
  requiredBy  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  requester    User         @relation("Requester", fields: [requesterId], references: [id])

  items     PurchaseRequestItem[]
  quotes    Quote[]
  analyses  QuoteAnalysis[]
  vendorQuoteRequests VendorQuoteRequest[]
  logs PurchaseRequestLog[]

}

model PurchaseRequestLog {
  id                String                  @id @default(uuid())
  organizationId    String
  purchaseRequestId String
  purchaseStatus    PurchaseRequestStatus
  performedBy       String
  performedAt       DateTime                @default(now())
  note              String?

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  performer       User            @relation(fields: [performedBy], references: [id])

  @@index([organizationId, purchaseRequestId, performedAt])
  @@map("purchaseRequestLogs")
}

model PurchaseRequestItem {
  id                String @id @default(uuid())
  purchaseRequestId String

  name           String
  description    String?
  quantity       Int
  specifications Json?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
}
