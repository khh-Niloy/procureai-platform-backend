model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role
  isActive           Boolean  @default(true)
  hashedRefreshToken String?
  updatedAt          DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  vendor           Vendor?
  purchaseRequests PurchaseRequest[] @relation("Requester")
  createdAnalyses  QuoteAnalysis[]   @relation("QuoteAnalysisCreator")
  approvals        Approval[]        @relation("ApprovalApprover")
  initialRequestApprovals PurchaseRequest[] @relation("InitialRequestApprover")
}
